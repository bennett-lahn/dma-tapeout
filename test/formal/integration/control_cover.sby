; control_cover.sby - Phase 0 stub (M4 fills integration cover jobs)
; Run from test/formal/integration/ with native WSL sby/yosys (see docs/llm/verification/07-formal.md)
; Harness: sys_qspi_harness and/or top_harness per cover goal.
; TODO(M4): FP-COV-* rows, legal-descriptor profile where required, calibrated depths.

[options]
mode cover
depth 128
multiclock off

[engines]
smtbmc bitwuzla

[script]
read -formal -sv ../../src/rtl/types.svh ../../src/rtl/qspi_engine.sv ../../src/rtl/sys_controller.sv
read -formal -sv sys_qspi_harness.sv ../bind/sys_controller_properties.sv ../bind/qspi_engine_properties.sv
prep -top sys_qspi_harness

[files]
../../src/rtl/types.svh
../../src/rtl/qspi_engine.sv
../../src/rtl/sys_controller.sv
sys_qspi_harness.sv
../bind/sys_controller_properties.sv
../bind/qspi_engine_properties.sv
